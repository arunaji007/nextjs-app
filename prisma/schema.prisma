generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://${env('DATABASE_USERNAME')}:${env('DATABASE_PASSWORD')}@${env('DATABASE_URL')}:${env('DATABASE_PORT')}/${env('DATABASE_NAME')}"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}
